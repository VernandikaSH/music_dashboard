# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Last.fm: https://www.last.fm/api/accounts
LASTFM_API_KEY=
LASTFM_USERNAME=

# Supabase: Project Settings -> Data API (URL) and API Keys (secret key, starts with sb_secret_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Password for logging in to the dashboard. Pick a long one.
DASHBOARD_PASSWORD=

# Random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=
